# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/

# Virtual environments
venv/
.venv/
env/
*/venv/
*/env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Compiled / binary artefacts
*.dll
*.dylib
*.exe
*.bin

# Cached raw dataset (re-fetched from UCI on demand).
# NOTE: this used to be a blanket `*.csv` rule, which silently excluded the
# committed offline sample in data/sample/. Scope data ignores to the cache only.
/data/raw/*
!/data/raw/.gitkeep

# Serialised models.
# NOTE: this used to be a bare `models/` rule, which silently excluded the
# financial_ai_framework/models/ source package. Keep it scoped to artefacts.
/saved_models/
*.joblib
*.pkl

# Generated reports (scorecards, model cards, SHAP artefacts)
/reports/*
!/reports/.gitkeep

# Other generated output
outputs/
results/

# LaTeX build intermediates. The whitepaper PDF itself is committed.
*.aux
*.toc
*.out
*.synctex.gz
/docs/*.log

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# MLflow
mlruns/
mlartifacts/
